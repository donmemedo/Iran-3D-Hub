# Keep secrets, node_modules (~400 MB) and build output out of the build context.
# Patterns are relative to the context root: use **/ for nested matches.
.git
.github
.gitignore
.idea
.vscode

**/node_modules
.next
out
coverage
*.tsbuildinfo

**/.env
**/.env.*
**/*.log
.DS_Store

Dockerfile
.dockerignore
**/*.md
docs
