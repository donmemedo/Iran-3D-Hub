# Copy to .env (git-ignored) and fill in. docker compose reads .env automatically.
#   cp .env.example .env && sed -i "s/^JWT_SECRET=.*/JWT_SECRET=$(openssl rand -hex 32)/" .env
# Never commit .env. Never reuse a secret between environments.

# ---- Required ----------------------------------------------------------------------
# HS256 signing key for login tokens and price quotes: at least 32 characters.
# Generate with:  openssl rand -hex 32
# Compose refuses to start while this is empty; the API refuses to start with a short or
# known-default value (unless DEV=true). Rotating it signs every user out.
JWT_SECRET=

# ---- Backend (all optional) ----------------------------------------------------------
# DEV=true turns on /docs and /openapi.json, accepts any localhost CORS origin and allows a
# random per-process secret. Local development only, never on a server.
DEV=false
# SEED_DEMO=true creates the public demo account demo@3dhub.ir / demo1234. Never in production.
SEED_DEMO=false
# SQLAlchemy URL. The compose default is a SQLite file on the backend-data volume.
# DATABASE_URL=sqlite:////app/data/hub3d.db
# Comma-separated browser origins allowed to call the API (exact match, no wildcard).
CORS_ORIGINS=http://localhost:3560
# Platform fee per order, as a fraction (0.15 = 15%).
PLATFORM_COMMISSION=0.15
# Largest accepted model upload, in MB.
MAX_UPLOAD_MB=60
# Login + register attempts per client IP per minute.
LOGIN_RATE_LIMIT=10
# Orders one user may place per hour.
ORDERS_PER_HOUR=60
# Proxy addresses uvicorn trusts for X-Forwarded-For. Keep 127.0.0.1 unless a reverse proxy
# in front of the API has this address; never use * on an exposed port (clients could spoof
# their IP and dodge the rate limiter).
FORWARDED_ALLOW_IPS=127.0.0.1

# ---- Compose / frontend --------------------------------------------------------------
# Interface the published ports bind to. 127.0.0.1 keeps a laptop run off the LAN.
BIND=127.0.0.1
# Public URL of the API as the BROWSER sees it. Baked into the frontend at build time
# (rebuild after changing) and used to narrow the CSP connect-src. Must be public: no secrets.
NEXT_PUBLIC_API_BASE=http://localhost:8400
# 1 shows the demo-login button. Build-time too. Pair with SEED_DEMO=true, demos only.
NEXT_PUBLIC_DEMO=
