# For running the API outside Docker: cp .env.example .env (git-ignored), run from backend/.
# Under docker compose, use the .env in the repo root instead (see ../.env.example).

# REQUIRED unless DEV=true: >= 32 random characters.  openssl rand -hex 32
# There is deliberately no default: the app refuses to start without a strong value.
JWT_SECRET=

# DEV=true: /docs on, any localhost CORS origin, random per-process secret if JWT_SECRET is empty.
DEV=false
# SEED_DEMO=true creates demo@3dhub.ir / demo1234 (never in production).
SEED_DEMO=false

DATABASE_URL=sqlite:///./data/hub3d.db
CORS_ORIGINS=http://localhost:3560,http://localhost:3000
PLATFORM_COMMISSION=0.15

# Limits and rate limits (defaults shown)
MAX_UPLOAD_MB=60
MAX_JSON_KB=64
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_S=60
ORDERS_PER_HOUR=60
ANALYZE_PER_MINUTE=30
MAX_PARALLEL_PARSES=2

# Token lifetimes in minutes (defaults shown: 24 h)
JWT_EXPIRE_MINUTES=1440
QUOTE_TTL_MINUTES=1440

# Read by uvicorn, not by the app: proxies whose X-Forwarded-For is trusted.
# FORWARDED_ALLOW_IPS=127.0.0.1
